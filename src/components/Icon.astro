---
// Simple line icons (generic, not brand logos).
interface Props { name: string; size?: number }
const { name, size = 16 } = Astro.props;
const paths: Record<string, string> = {
  github: "M9 7 4 12l5 5M15 7l5 5-5 5",
  scholar: "M2 9l10-5 10 5-10 5-10-5zM6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5M22 9v6",
  orcid: "M4 5h16v14H4zM8 9v6M12 9h2.5a3 3 0 0 1 0 6H12z",
  linkedin: "M4 8h16v12H4zM9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8M4 13h16",
  mail: "M3 6h18v12H3zM3 7l9 6 9-6",
  pin: "M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  download: "M12 4v11m0 0-4-4m4 4 4-4M5 20h14",
  pulse: "M2 13h4l3-8 4 14 3-7h6",
  doc: "M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6",
  slides: "M3 4h18v12H3zM12 16v4M8 20h8",
  quote: "M7 7h4v4c0 3-2 5-4 6M15 7h4v4c0 3-2 5-4 6",
  arrow: "M5 12h14m-5-5 5 5-5 5",
};
const d = paths[name] ?? paths.arrow;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d}></path></svg>
