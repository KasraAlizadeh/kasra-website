---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../scripts/utils";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---
<BaseLayout title="Blog" description="Notes by Kasra Alizadeh on signal processing, communication systems, and building AI software.">
  <section class="blk first">
    <div class="wrap">
      <SectionHead as="h1" ch="LOG" color="var(--ink-2)" title="Blog" sub="Notes on signals, communication systems, and building AI software." />
      <div class="blog-head">
        <div class="filters" role="group" aria-label="Filter posts by tag">
          <button type="button" aria-pressed="true" data-tag="">All</button>
          {tags.map((t) => <button type="button" aria-pressed="false" data-tag={t}>{t}</button>)}
        </div>
        <a class="rss" href="/rss.xml">RSS feed</a>
      </div>
      <div class="posts" id="posts">{posts.map((post) => <PostCard post={post} />)}</div>
      {posts.length === 0 && <div class="panel empty">No posts yet.</div>}
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filters button"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("#posts .post-card"));
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const tag = b.dataset.tag ?? "";
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      cards.forEach((c) => (c.hidden = !!tag && !(c.dataset.tags ?? "").split("|").includes(tag)));
    }),
  );
  const initial = new URLSearchParams(location.search).get("tag");
  if (initial) buttons.find((b) => b.dataset.tag === initial)?.click();
</script>
