---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="blk first nf">
    <div class="wrap">
      <div class="panel nf-box">
        <div class="nf-code">404</div>
        <h1>No signal on this channel</h1>
        <p>The page you're looking for doesn't exist or has moved.</p>
        <div class="cta"><a class="btn primary" href="/">Back to home</a><a class="btn" href="/blog/">Read the blog</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
